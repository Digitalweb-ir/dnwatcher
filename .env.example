# DigitalNetworkWatcher — متغیرهای محیطی
# کپی کنید به .env و مقادیر را پر کنید

# ------------------------------------------------------------
# امنیت (الزامی در تولید)
# ------------------------------------------------------------
# کلید ۳۲ بایتی برای رمزنگاری AES-256-GCM لینک‌های ساب
# تولید: openssl rand -hex 32
ENCRYPTION_KEY=

# رمز مدیر برای ورود به پنل
# در اولین اجرا اگر تنظیم نشود، پیش‌فرض «admin» خواهد بود
ADMIN_PASSWORD=

# کلید امضای نشست (JWT HS256) — حداقل ۳۲ بایت
# تولید: openssl rand -hex 32
SESSION_SECRET=

# ------------------------------------------------------------
# دیتابیس
# ------------------------------------------------------------
# مسیر فایل SQLite (پوشه باید قابل نوشتن باشد)
# در کانتینر: /data/watch.db
DEBUG=false
DB_PATH=./data/watch.db

# ------------------------------------------------------------
# Xray
# ------------------------------------------------------------
# مسیر باینری Xray (اختیاری — اگر تنظیم نشود از PATH یا ./bin/xray استفاده می‌شود)
# XRAY_BINARY=/usr/local/bin/xray

# ------------------------------------------------------------
# اجرای dev/production
# ------------------------------------------------------------
# NODE_ENV=production
# NEXT_TELEMETRY_DISABLED=1
#------------------------------------------------------------
