# DigitalNetworkWatcher — Environment Variables
# Copy to .env and fill in the values

# ------------------------------------------------------------
# Security (required in production)
# ------------------------------------------------------------
# 32-byte key for AES-256-GCM encryption of subscription links
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Admin password for panel login
# Defaults to "admin" if not set on first run
ADMIN_PASSWORD=

# Session signing key (JWT HS256) — minimum 32 bytes
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# ------------------------------------------------------------
# Database
# ------------------------------------------------------------
# SQLite file path (directory must be writable)
# Inside container: /data/watch.db
DEBUG=false
DB_PATH=./data/watch.db

# ------------------------------------------------------------
# Xray
# ------------------------------------------------------------
# Xray binary path (optional — uses PATH or ./bin/xray if unset)
# XRAY_BINARY=/usr/local/bin/xray

# ------------------------------------------------------------
# Dev/Production
# ------------------------------------------------------------
# NODE_ENV=production
# NEXT_TELEMETRY_DISABLED=1